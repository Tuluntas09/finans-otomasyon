# Finnhub API anahtarı — https://finnhub.io/dashboard
# Kendi anahtarını gir, bu dosyayı .env olarak kopyala
FINNHUB_API_KEY=your_finnhub_key_here

# (Opsiyonel) Günlük rapor e-postası için
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=app_password_here
# REPORT_TO_EMAIL=destination@example.com

# Yerel saat dilimi (TR varsayılan)
TIMEZONE=Europe/Istanbul
